{
  "10": {
    "class_type": "UnetLoaderGGUF",
    "_meta": {"title": "Load Qwen-Image (GGUF)"},
    "inputs": {"unet_name": "qwen-image-Q4_K_M.gguf"}
  },
  "11": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {"title": "Model Sampling (shift)"},
    "inputs": {"model": ["10", 0], "shift": 3.1}
  },
  "12": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load Qwen2.5-VL Text Encoder"},
    "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image"}
  },
  "13": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"},
    "inputs": {"text": "a photograph", "clip": ["12", 0]}
  },
  "14": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"},
    "inputs": {"text": "低品質, 模糊, 變形, 多餘手指, 浮水印, blurry, low quality, distorted, extra fingers, watermark", "clip": ["12", 0]}
  },
  "15": {
    "class_type": "VAELoader",
    "_meta": {"title": "Load Qwen-Image VAE"},
    "inputs": {"vae_name": "qwen_image_vae.safetensors"}
  },
  "16": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Empty Latent"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "3": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"},
    "inputs": {
      "model": ["11", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["13", 0],
      "negative": ["14", 0],
      "latent_image": ["16", 0],
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["3", 0], "vae": ["15", 0]}
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save Image"},
    "inputs": {"images": ["8", 0], "filename_prefix": "qwen"}
  }
}
