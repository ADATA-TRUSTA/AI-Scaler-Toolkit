  },
  "13": {
    "class_type": "TextEncodeQwenImage21",
    "_meta": {"title": "Qwen Image 2.1 Text Encode (t2i)"},
    "inputs": {
      "clip": ["12", 0],
      "vae": ["15", 0],
      "prompt": "a photograph",
