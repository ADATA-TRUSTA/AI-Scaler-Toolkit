    "inputs": {
      "model": ["11", 0],
      "seed": 0,
      "steps": 12,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "positive": ["27", 0],
      "negative": ["33", 0],
      "latent_image": ["80", 0],
      "denoise": 0.6
