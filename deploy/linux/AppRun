#!/usr/bin/env bash
#
# AppImage entry point.
#
# Three jobs: say something a person can read when a dependency is missing, make sure
# the launcher has an interpreter that can draw a window, and start it.
#
# WebKitGTK is deliberately not bundled. It is large, and a bundled copy conflicts
# with the system one often enough that shipping it causes more breakage than
# depending on it does -- so this checks for it and says what to install instead of
# failing with a Python traceback about a missing GObject library.

set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
APP_ID="ai-scaler-toolkit"
APP_TITLE="AI Scaler Toolkit"
APP_ROOT="$HERE/usr/share/$APP_ID"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/$APP_ID"
USER_BIN="${XDG_BIN_HOME:-$HOME/.local/bin}"
VENV="$DATA_DIR/launcher-venv"
REQUIREMENTS="$APP_ROOT/launcher-requirements.txt"
# PyGObject, built for LAUNCHER_PYTHON when this AppImage was built. See
# ensure_launcher_env for why it is carried rather than borrowed from the system.
GI_DIR="$APP_ROOT/launcher-gi"
LAUNCHER_PYTHON="3.12"

export PATH="$HERE/usr/bin:$USER_BIN:$PATH"

# Nothing here is started from a terminal. The .desktop entry is Terminal=false, and
# so is every other way a desktop launches an application -- an icon, a menu entry,
# the autostart directory. Writing a diagnosis to stderr in that situation puts it
# nowhere at all: the user double-clicks, nothing appears, and there is no error to
# find. So say it in whatever a desktop has, and keep stderr as the last resort for
# the case where this really was run from a shell.
report_problem() {
  local body="$1"
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --no-wrap --title="$APP_TITLE" --text="$body" >/dev/null 2>&1 && return 0
  fi
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "$APP_TITLE" --error "$body" >/dev/null 2>&1 && return 0
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --urgency=critical "$APP_TITLE" "$body" >/dev/null 2>&1 && return 0
  fi
  printf '%s\n' "$body" >&2
}

# The typelib, not the shared library. pywebview reaches WebKitGTK through gi, so what
# has to be there is WebKit2-4.1.typelib from gir1.2-webkit2-4.1 -- a different package
# from the library, and a different major from the 4.0 that Ubuntu 22.04 ships by
# default. Globbing libwebkit2gtk-*.so* matched both of those cases, so the check passed
# on machines that then failed to draw a window with
#
#   WebViewException: You must have either QT or GTK with Python extensions installed
#
# which is the Python traceback this check exists to replace.
have_webkitgtk() {
  local dir
  for dir in /usr/lib/x86_64-linux-gnu/girepository-1.0 \
             /usr/lib/aarch64-linux-gnu/girepository-1.0 \
             /usr/lib64/girepository-1.0 /usr/lib/girepository-1.0; do
    [[ -d "$dir" ]] || continue
    compgen -G "$dir/WebKit2-4.1.typelib" >/dev/null && return 0
  done
  return 1
}

# The typelib pystray's AppIndicator backend loads. Stock Ubuntu Desktop has it, as a
# dependency of the GNOME extension that draws the tray at all; a minimal Debian or a
# desktop assembled by hand may not, and then pystray silently falls back to its Xorg
# backend, which draws nothing a modern desktop will show.
have_tray_typelib() {
  local dir
  for dir in /usr/lib/x86_64-linux-gnu/girepository-1.0 \
             /usr/lib/aarch64-linux-gnu/girepository-1.0 \
             /usr/lib64/girepository-1.0 /usr/lib/girepository-1.0; do
    [[ -d "$dir" ]] || continue
    compgen -G "$dir/AyatanaAppIndicator3-*.typelib" >/dev/null && return 0
    compgen -G "$dir/AppIndicator3-*.typelib" >/dev/null && return 0
  done
  return 1
}

# Install apt packages from a desktop session, where there is no terminal to type a
# password into. pkexec puts polkit's own dialog on screen, which is how a desktop
# application is supposed to ask; passwordless sudo (containers, kiosks) is taken
# first because it needs no interaction at all.
#
# Returns non-zero without asking on anything that is not apt-based, so callers still
# have to handle "it is not installed and I could not install it".
apt_install() {
  command -v apt-get >/dev/null 2>&1 || return 1
  local -a as_root=()
  if ((EUID != 0)); then
    if sudo -n true 2>/dev/null; then
      as_root=(sudo -n)
    elif command -v pkexec >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
      as_root=(pkexec)
    else
      return 1
    fi
  fi
  # env, not a bare assignment: both sudo and pkexec drop the caller's environment.
  "${as_root[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" >/dev/null 2>&1 && return 0

  # Refresh and try once more, the way setup_env.sh's copy of this already does. A
  # desktop installed from an image a few months old has an index naming versions the
  # mirrors no longer carry, so the first install fails with 404s -- and without this
  # the user is told to install it by hand on a machine where one update would have
  # fixed it.
  "${as_root[@]}" env DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || return 1
  "${as_root[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" >/dev/null 2>&1
}

# curl, wget, then python3. A clean Ubuntu Desktop has no curl -- measured, not
# assumed. python3 is the backstop because GNOME depends on it.
fetch_to() {
  local url="$1" out="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -LsSf "$url" -o "$out"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$out" "$url"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys,urllib.request; open(sys.argv[2],"wb").write(urllib.request.urlopen(sys.argv[1],timeout=60).read())' "$url" "$out"
  else
    return 1
  fi
  [[ -s "$out" ]]
}

ensure_uv() {
  # The copy this AppImage carries, pinned and hashed at build time, before anything
  # on the machine and before the network. It is put on PATH rather than only called
  # by path, because uv re-executes itself by name and a bare "uv" has to reach the
  # same binary. See deploy/package/uvtool.py.
  if [[ -x "$APP_ROOT/uv/uv" ]]; then
    PATH="$APP_ROOT/uv:$PATH"
    export PATH
    return 0
  fi
  command -v uv >/dev/null 2>&1 && return 0
  local script
  script="$(mktemp)"
  if ! fetch_to "https://astral.sh/uv/install.sh" "$script"; then
    rm -f "$script"
    report_problem "$APP_TITLE needs uv, and it could not be downloaded.

Check the network connection and try again, or install it by hand:

  curl -LsSf https://astral.sh/uv/install.sh | sh

It installs into your home directory and needs no administrator rights."
    return 1
  fi
  env UV_INSTALL_DIR="$USER_BIN" UV_UNMANAGED_INSTALL="$USER_BIN" sh "$script" >/dev/null 2>&1
  rm -f "$script"
  command -v uv >/dev/null 2>&1
}

# The launcher runs on an interpreter uv manages, with the PyGObject this AppImage
# carries, built for that interpreter when the AppImage was built.
#
# It used to run on /usr/bin/python3 with --system-site-packages, because pywebview
# draws its window through PyGObject and PyGObject is an ABI-tagged C extension of the
# distribution's Python: cp310 on Ubuntu 22.04, cp312 on 24.04. Borrowing it meant
# borrowing the interpreter, and that meant a different Python -- and so a different
# resolution of every other package -- on every distribution, which is the opposite of
# what shipping a single artifact is for.
#
# Carrying gi cuts that tie. The extension links against libglib, libgobject and
# libgirepository-1.0.so.1 and nothing else, all present with a stable ABI across the
# range this supports, so one build works everywhere. The typelibs and the libraries
# still come from the machine; only the Python binding is ours.
#
# Everything else pywebview needs (itself, pystray, pillow, pyyaml) comes from the
# requirements file beside this AppImage, hash-pinned from the same lock the Windows
# build freezes from -- which is only possible because the interpreter is now fixed.
ensure_launcher_env() {
  local stamp="$VENV/.requirements-stamp"
  local want
  # Both inputs, because a rebuilt gi with unchanged requirements is still a different
  # environment, and reusing the old one would keep an extension built for another
  # interpreter in place.
  want="$( { sha256sum "$REQUIREMENTS"; find "$GI_DIR" -type f -exec sha256sum {} + 2>/dev/null; } \
           | sort | sha256sum | cut -d' ' -f1)"

  if [[ -x "$VENV/bin/python" && -n "$want" && -f "$stamp" ]] \
     && [[ "$(cat "$stamp")" == "$want" ]]; then
    # The environment is right, but where gi lives is not -- see link_bundled_gi.
    link_bundled_gi
    return $?
  fi

  ensure_uv || return 1

  rm -rf "$VENV"
  mkdir -p "$(dirname "$VENV")"
  # No --system-site-packages: the distribution's packages are built for its own
  # interpreter, and mixing them into this one is what this arrangement exists to stop.
  #
  # only-managed, because "--python 3.12" alone takes whatever 3.12 the machine already
  # has and only downloads one when there is none. That reintroduces exactly what this
  # replaced: observed here, the same command produced uv's 3.12.14 on a machine that
  # had it cached and the distribution's 3.12.3 on one that did not. Both load the
  # carried gi and select the same wheels, so nothing visibly breaks -- which is what
  # makes it worth pinning rather than leaving to chance.
  if ! uv venv --python "$LAUNCHER_PYTHON" --python-preference only-managed "$VENV" >/dev/null 2>&1; then
    report_problem "$APP_TITLE could not create its Python environment at

  $VENV

It needs to download Python $LAUNCHER_PYTHON the first time. Check the network
connection and that there is space in your home directory."
    return 1
  fi
  if ! uv pip install --python "$VENV/bin/python" --quiet -r "$REQUIREMENTS" >/dev/null 2>&1; then
    report_problem "$APP_TITLE could not install the packages it needs to draw its window.

Check the network connection and try again."
    return 1
  fi

  link_bundled_gi || return 1
  printf '%s' "$want" > "$stamp"
}

# Point the environment at the gi this AppImage carries. Rewritten on every start, not
# only when the environment is rebuilt, because the path changes on every start: an
# AppImage mounts itself at a fresh /tmp/.mount_XXXXXX each time it runs, and $GI_DIR is
# inside it. Written once and left, the file names a mount that no longer exists -- the
# second launch of a build then cannot import gi and pywebview says "You must have
# either QT or GTK with Python extensions installed", which is no window at all.
#
# That is not hypothetical, and it hid well: rebuilding the AppImage changes the hash
# the environment is stamped with, which rebuilds it and rewrites this file, so every
# test that followed a build passed. Only a second run of the same build fails, which is
# what every user does and no build-and-test cycle does.
#
# A .pth rather than PYTHONPATH: this process starts the backend, and PYTHONPATH is
# inherited, so it would put this interpreter's gi on the path of a service that has its
# own environment. A .pth belongs to this interpreter and goes no further.
link_bundled_gi() {
  local site
  site="$("$VENV/bin/python" -c 'import site; print(site.getsitepackages()[0])' 2>/dev/null)"
  if [[ -z "$site" ]]; then
    report_problem "$APP_TITLE could not work out where to install its GTK bindings."
    return 1
  fi
  printf '%s\n' "$GI_DIR" > "$site/trusta-gi.pth"

  if ! "$VENV/bin/python" -c 'import gi' >/dev/null 2>&1; then
    report_problem "$APP_TITLE carries GTK bindings that this system cannot load.

This build is for x86_64 systems with GLib 2.72 or newer. Please report it with
your distribution and version."
    return 1
  fi
}

# llama.cpp is built on this machine during first setup: there is no Linux CUDA build
# to download, and a local build is tuned to this CPU. So first setup needs a C and C++
# compiler and cmake, which a desktop Ubuntu does not have. setup_env.sh, started from
# the launcher with no terminal, cannot ask for a password -- it can only stop and say
# what to install -- so they are asked for here, with everything else.
missing_build_tools() {
  command -v cmake >/dev/null 2>&1 || echo cmake
  if ! { command -v cc || command -v gcc; } >/dev/null 2>&1 ||
     ! { command -v c++ || command -v g++; } >/dev/null 2>&1; then
    echo build-essential
  fi
}

# Whether any GPU from this PCI vendor is present, read from sysfs: lspci is not on
# every desktop, and this runs before anything is installed.
has_gpu_vendor() {
  local v
  for v in /sys/class/drm/card*/device/vendor; do
    [[ -r "$v" && "$(<"$v")" == "$1" ]] && return 0
  done
  return 1
}

# The packages named that are not installed and that this release's archive carries.
# Filtered by availability first because apt installs all or nothing: one name a
# release does not have (Level Zero is not in 22.04's archive) would otherwise sink the
# window's own packages along with it.
apt_wanted() {
  command -v dpkg-query >/dev/null 2>&1 || return 0
  local p
  for p in "$@"; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed" && continue
    apt-cache show "$p" >/dev/null 2>&1 && echo "$p"
  done
}

# An Intel GPU takes the XPU build of torch and the Vulkan build of llama, and a stock
# Ubuntu has neither half's user-space. The kernel driver is in the box; what is not:
#
#   libze1 libze-intel-gpu1 intel-opencl-icd   Level Zero and OpenCL, which torch's
#                                              XPU backend talks to the GPU through.
#                                              Without them it counts zero devices and
#                                              setup fails its XPU check
#   libze-dev                                  only for libze_loader.so, the unversioned
#                                              name oneCCL opens: training fails without
#                                              it although inference works
#   mesa-vulkan-drivers vulkan-tools           the Vulkan driver itself, and vulkaninfo,
#                                              which is how preflight looks for it
#   libvulkan-dev glslc spirv-headers          what llama's Vulkan backend compiles
#                                              against, beside cmake and the compilers
#
# Found by installing on two Panther Lake laptops (Ubuntu 24.04): both failed setup
# twice, once at the XPU check and once at the llama build, and both completed once
# these were installed by hand. On Windows the same pieces come with Intel's driver.
#
# What this cannot do is make them new enough. 24.04's archive carries compute runtime
# 23.43, from before Lunar Lake; those laptops needed 26.31 from Intel's graphics PPA
# (ppa:kobuk-team/intel-graphics). Adding a package source is the user's decision, not
# a side effect of opening an application, so the install docs say to add it first and
# this installs from whatever sources the machine has -- the PPA's builds when it is
# there, the archive's when it is not.
#
# Not for NVIDIA, which takes the CUDA builds and needs none of it: the same rule as
# preflight's, nvidia-smi first, and TRUSTA_ACCEL decides when it is set.
intel_gpu_packages() {
  case "${TRUSTA_ACCEL:-}" in
    cuda) return 0 ;;
    xpu) ;;
    *)
      command -v nvidia-smi >/dev/null 2>&1 && return 0
      has_gpu_vendor 0x8086 || return 0
      ;;
  esac
  apt_wanted libze1 libze-intel-gpu1 intel-opencl-icd libze-dev \
             mesa-vulkan-drivers vulkan-tools \
             libvulkan-dev glslc spirv-headers
}

# Everything missing, in one apt_install: from a desktop each call is a polkit password
# dialog, and first launch used to show one for WebKitGTK and another for the tray. If
# the lot fails together -- one name this distribution does not carry -- the window's
# own packages are tried again alone, so nothing optional can cost the user the window.
webkit_packages=(libwebkit2gtk-4.1-0 gir1.2-webkit2-4.1)
wanted=()
have_webkitgtk || wanted+=("${webkit_packages[@]}")
have_tray_typelib || wanted+=(gir1.2-ayatanaappindicator3-0.1)
mapfile -t build_tools < <(missing_build_tools)
wanted+=("${build_tools[@]}")
mapfile -t gpu_packages < <(intel_gpu_packages)
wanted+=("${gpu_packages[@]}")
if ((${#wanted[@]})); then
  if ! apt_install "${wanted[@]}" && ! have_webkitgtk; then
    apt_install "${webkit_packages[@]}" || true
  fi
fi

if ! have_webkitgtk; then
  # The exact package name differs per distribution, so name the common ones rather
  # than guessing one and being wrong.
  report_problem "$APP_TITLE needs WebKitGTK to draw its window, and it is not installed.

  Debian / Ubuntu   sudo apt install libwebkit2gtk-4.1-0 gir1.2-webkit2-4.1
  Fedora            sudo dnf install webkit2gtk4.1
  Arch              sudo pacman -S webkit2gtk-4.1
  openSUSE          sudo zypper install libwebkit2gtk-4_1-0

It is not bundled on purpose: a bundled copy conflicts with the system one more
often than the dependency itself causes trouble."
  exit 1
fi

# The tray is best effort, and deliberately quiet: the window is the product and the
# tray a convenience, so a machine that will not install it still gets a working
# program. Installed above rather than from Python because it has to be there before
# the process that will load the typelib starts.
have_tray_typelib || echo "[AppRun] no AppIndicator typelib; starting without a tray icon" >&2

# Not fatal here: the program runs, and first setup stops with the command to run if
# the build tools are still missing then. Said now too, for whoever reads the log.
mapfile -t build_tools < <(missing_build_tools)
((${#build_tools[@]} == 0)) ||
  echo "[AppRun] first setup will need: ${build_tools[*]} (sudo apt install ${build_tools[*]})" >&2
mapfile -t gpu_packages < <(intel_gpu_packages)
((${#gpu_packages[@]} == 0)) ||
  echo "[AppRun] the Intel GPU still needs: ${gpu_packages[*]} (sudo apt install ${gpu_packages[*]})" >&2

if [[ ! -f "$REQUIREMENTS" ]]; then
  report_problem "This build of $APP_TITLE is incomplete: it carries no

  usr/share/$APP_ID/launcher-requirements.txt

so there is no way to know what the launcher needs. Please report this build as
broken."
  exit 1
fi

if [[ ! -d "$GI_DIR/gi" ]]; then
  report_problem "This build of $APP_TITLE is incomplete: it carries no

  usr/share/$APP_ID/launcher-gi

so there is nothing to draw its window with. Please report this build as broken."
  exit 1
fi

ensure_launcher_env || exit 1

cd "$APP_ROOT"
export PYTHONPATH="$APP_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV/bin/python" -m launcher "$@"
