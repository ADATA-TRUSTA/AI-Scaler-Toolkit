#!/usr/bin/env bash
#
# AppImage entry point.
#
# Three jobs: say something a person can read when a dependency is missing, make sure
# the launcher has an interpreter that can draw a window, and start it.
#
# WebKitGTK is deliberately not bundled. It is large, and a bundled copy conflicts
# with the system one often enough that shipping it causes more breakage than
# depending on it does -- so this checks for it and says what to install instead of
# failing with a Python traceback about a missing GObject library.

set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
APP_ID="ai-scaler-toolkit"
APP_TITLE="AI Scaler Toolkit"
APP_ROOT="$HERE/usr/share/$APP_ID"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/$APP_ID"
USER_BIN="${XDG_BIN_HOME:-$HOME/.local/bin}"
VENV="$DATA_DIR/launcher-venv"
REQUIREMENTS="$APP_ROOT/launcher-requirements.txt"

export PATH="$HERE/usr/bin:$USER_BIN:$PATH"

# Nothing here is started from a terminal. The .desktop entry is Terminal=false, and
# so is every other way a desktop launches an application -- an icon, a menu entry,
# the autostart directory. Writing a diagnosis to stderr in that situation puts it
# nowhere at all: the user double-clicks, nothing appears, and there is no error to
# find. So say it in whatever a desktop has, and keep stderr as the last resort for
# the case where this really was run from a shell.
report_problem() {
  local body="$1"
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --no-wrap --title="$APP_TITLE" --text="$body" >/dev/null 2>&1 && return 0
  fi
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "$APP_TITLE" --error "$body" >/dev/null 2>&1 && return 0
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --urgency=critical "$APP_TITLE" "$body" >/dev/null 2>&1 && return 0
  fi
  printf '%s\n' "$body" >&2
}

have_webkitgtk() {
  local dir
  for dir in /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu; do
    [[ -d "$dir" ]] || continue
    compgen -G "$dir/libwebkit2gtk-*.so*" >/dev/null && return 0
  done
  return 1
}

# The typelib pystray's AppIndicator backend loads. Stock Ubuntu Desktop has it, as a
# dependency of the GNOME extension that draws the tray at all; a minimal Debian or a
# desktop assembled by hand may not, and then pystray silently falls back to its Xorg
# backend, which draws nothing a modern desktop will show.
have_tray_typelib() {
  local dir
  for dir in /usr/lib/x86_64-linux-gnu/girepository-1.0 \
             /usr/lib/aarch64-linux-gnu/girepository-1.0 \
             /usr/lib64/girepository-1.0 /usr/lib/girepository-1.0; do
    [[ -d "$dir" ]] || continue
    compgen -G "$dir/AyatanaAppIndicator3-*.typelib" >/dev/null && return 0
    compgen -G "$dir/AppIndicator3-*.typelib" >/dev/null && return 0
  done
  return 1
}

# Install apt packages from a desktop session, where there is no terminal to type a
# password into. pkexec puts polkit's own dialog on screen, which is how a desktop
# application is supposed to ask; passwordless sudo (containers, kiosks) is taken
# first because it needs no interaction at all.
#
# Returns non-zero without asking on anything that is not apt-based, so callers still
# have to handle "it is not installed and I could not install it".
apt_install() {
  command -v apt-get >/dev/null 2>&1 || return 1
  local -a as_root=()
  if ((EUID != 0)); then
    if sudo -n true 2>/dev/null; then
      as_root=(sudo -n)
    elif command -v pkexec >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
      as_root=(pkexec)
    else
      return 1
    fi
  fi
  # env, not a bare assignment: both sudo and pkexec drop the caller's environment.
  "${as_root[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" >/dev/null 2>&1
}

# curl, wget, then python3. A clean Ubuntu Desktop has no curl -- measured, not
# assumed. python3 is the backstop because GNOME depends on it.
fetch_to() {
  local url="$1" out="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -LsSf "$url" -o "$out"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$out" "$url"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys,urllib.request; open(sys.argv[2],"wb").write(urllib.request.urlopen(sys.argv[1],timeout=60).read())' "$url" "$out"
  else
    return 1
  fi
  [[ -s "$out" ]]
}

ensure_uv() {
  command -v uv >/dev/null 2>&1 && return 0
  local script
  script="$(mktemp)"
  if ! fetch_to "https://astral.sh/uv/install.sh" "$script"; then
    rm -f "$script"
    report_problem "$APP_TITLE needs uv, and it could not be downloaded.

Check the network connection and try again, or install it by hand:

  curl -LsSf https://astral.sh/uv/install.sh | sh

It installs into your home directory and needs no administrator rights."
    return 1
  fi
  env UV_INSTALL_DIR="$USER_BIN" UV_UNMANAGED_INSTALL="$USER_BIN" sh "$script" >/dev/null 2>&1
  rm -f "$script"
  command -v uv >/dev/null 2>&1
}

# The launcher runs on the system Python, in a virtual environment that can see the
# system's site-packages. That is not a preference, it is the only arrangement that
# works: pywebview draws its window through PyGObject, and PyGObject is a compiled
# module tied to the system Python and the system's typelibs. A frozen launcher
# carries its own interpreter, cannot see gi, and fails with
#
#   [pywebview] GTK cannot be loaded -- ModuleNotFoundError: No module named 'gi'
#   WebViewException: You must have either QT or GTK with Python extensions installed
#
# every time, on every machine. Windows has no equivalent problem -- WebView2 is a
# system component reached through COM, not a Python extension -- which is why the
# two platforms are packaged differently.
#
# Everything else pywebview needs (itself, pystray, pillow, pyyaml) is pip-installable
# and goes in the virtual environment, pinned by the requirements file built beside
# this AppImage from the same lock the Windows build uses.
ensure_launcher_env() {
  local stamp="$VENV/.requirements-stamp"
  local want
  want="$(sha256sum "$REQUIREMENTS" 2>/dev/null | cut -d' ' -f1)"

  if [[ -x "$VENV/bin/python" && -n "$want" && -f "$stamp" ]] \
     && [[ "$(cat "$stamp")" == "$want" ]]; then
    return 0
  fi

  ensure_uv || return 1

  # --system-site-packages is the whole point; --python /usr/bin/python3 because a
  # uv-managed interpreter would be a different build with no gi beside it.
  rm -rf "$VENV"
  mkdir -p "$(dirname "$VENV")"
  if ! uv venv --python /usr/bin/python3 --system-site-packages "$VENV" >/dev/null 2>&1; then
    report_problem "$APP_TITLE could not create its Python environment at

  $VENV

Check that /usr/bin/python3 exists and that there is space in your home directory."
    return 1
  fi
  if ! uv pip install --python "$VENV/bin/python" --quiet -r "$REQUIREMENTS" >/dev/null 2>&1; then
    report_problem "$APP_TITLE could not install the packages it needs to draw its window.

Check the network connection and try again."
    return 1
  fi
  printf '%s' "$want" > "$stamp"
}

if ! have_webkitgtk; then
  apt_install libwebkit2gtk-4.1-0 gir1.2-webkit2-4.1 || true
fi

if ! have_webkitgtk; then
  # The exact package name differs per distribution, so name the common ones rather
  # than guessing one and being wrong.
  report_problem "$APP_TITLE needs WebKitGTK to draw its window, and it is not installed.

  Debian / Ubuntu   sudo apt install libwebkit2gtk-4.1-0 gir1.2-webkit2-4.1
  Fedora            sudo dnf install webkit2gtk4.1
  Arch              sudo pacman -S webkit2gtk-4.1
  openSUSE          sudo zypper install libwebkit2gtk-4_1-0

It is not bundled on purpose: a bundled copy conflicts with the system one more
often than the dependency itself causes trouble."
  exit 1
fi

# Best effort, and deliberately quiet: the window is the product and the tray is a
# convenience, so a machine that will not install this still gets a working program.
# It is attempted here rather than from Python because it has to happen before the
# process that will load the typelib starts.
if ! have_tray_typelib; then
  apt_install gir1.2-ayatanaappindicator3-0.1 || true
  have_tray_typelib || echo "[AppRun] no AppIndicator typelib; starting without a tray icon" >&2
fi

if [[ ! -f "$REQUIREMENTS" ]]; then
  report_problem "This build of $APP_TITLE is incomplete: it carries no

  usr/share/$APP_ID/launcher-requirements.txt

so there is no way to know what the launcher needs. Please report this build as
broken."
  exit 1
fi

ensure_launcher_env || exit 1

cd "$APP_ROOT"
export PYTHONPATH="$APP_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV/bin/python" -m launcher "$@"
