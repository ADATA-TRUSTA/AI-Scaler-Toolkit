# Copy this file to .env and adjust as needed. .env is not version-controlled.

# ==================== Required ====================
# BACKEND_URL: base URL of the AI Scaler backend, without the /v1 suffix.
BACKEND_URL=http://127.0.0.1:8000

# ==================== Optional ====================
# API_KEY: only for a backend on another computer -- the key set in that
# computer's AI Scaler Toolkit settings, sent as "Authorization: Bearer <key>".
# A backend on this computer needs none. Another computer's backend answers only
# its inference API (/v1/) unless it was set to allow the rest, so model loading
# and training from here get a 403 there by default. Unset means "EMPTY": the
# OpenAI SDK refuses an empty key, and the model/training client sends no header.
# API_KEY=EMPTY

# VERIFY_SSL: set to false ONLY when the backend serves https with a
# self-signed certificate. Has no effect on plain-http backends.
# VERIFY_SSL=true
