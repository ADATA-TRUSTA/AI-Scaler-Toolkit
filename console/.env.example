# Copy this file to .env and adjust as needed. .env is not version-controlled.

# ==================== Required ====================
# BACKEND_URL: base URL of the AI Scaler backend, without the /v1 suffix.
BACKEND_URL=http://127.0.0.1:8000

# ==================== Optional ====================
# API_KEY: placeholder credential. The backend does not authenticate requests;
# this exists only because the OpenAI SDK refuses an empty api_key. Any string
# works. Defaults to "EMPTY", the same placeholder the backend uses internally.
# API_KEY=EMPTY

# VERIFY_SSL: set to false ONLY when the backend serves https with a
# self-signed certificate. Has no effect on plain-http backends.
# VERIFY_SSL=true
