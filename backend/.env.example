# Environment Configuration Example
# Copy this file to .env and fill in your actual values
# On/off settings take true/1/yes/on or false/0/no/off; anything else keeps the default, with a warning.

# ==================== Service ====================
# SERVICE_HOST: network address FastAPI / Uvicorn binds to
# 127.0.0.1 allows local connections only (recommended); 0.0.0.0 allows external ones (pair it with a reverse proxy and auth)
SERVICE_HOST=127.0.0.1
# SERVICE_PORT: backend API service port
SERVICE_PORT=8000
# SERVICE_API_KEY: the key other machines must send (Authorization: Bearer <key>) when SERVICE_HOST
# opens the service to the network. Requests from this machine never need it. Empty: other machines
# are refused. The web interface and /docs are for this machine only, key or not.
# SERVICE_API_KEY=
# SERVICE_REMOTE_ACCESS: what other machines may use with that key.
#   inference  the OpenAI-compatible API under /v1/ only (chat, completions, embeddings, models)
#   all        also the management API: loading models, downloads, fine-tuning, RAG, system info.
#              Those take file paths and launch arguments, so a key holder reaches well beyond the
#              model. Use "all" only behind your own protection: a VPN such as Tailscale, or a
#              reverse proxy with TLS and authentication, and never straight onto the internet.
# The desktop application always runs with "inference".
# SERVICE_REMOTE_ACCESS=inference
# UVICORN_RELOAD: enable hot reload; true for development, false recommended in production
UVICORN_RELOAD=false

# ==================== Logging ====================
# LOG_LEVEL: root log level (DEBUG / INFO / WARNING / ERROR / CRITICAL)
LOG_LEVEL=INFO
# LOG_TO_FILE: whether to write logs to a file
LOG_TO_FILE=true
# LOG_DIR: log output directory
LOG_DIR=./logs
# LOG_FILE_NAME: main log file name
LOG_FILE_NAME=service.log
# LOG_BACKUP_COUNT: how many rotated log files to keep
LOG_BACKUP_COUNT=14
# UVICORN_ACCESS_LOG: whether to emit HTTP access logs
UVICORN_ACCESS_LOG=true

# ==================== Paths ====================
# HF_HOME: root directory for Hugging Face models, tokenizers, and download caches
HF_HOME=./.cache/huggingface

# LLAMA_SERVER_BINARY: full path to the llama executable
# (defaults to what setup_env installs: service/utils/llama-bin/llama-server[.exe])
# setup_env fills this line in with the binary it verified, and keeps the file to a single
# LLAMA_SERVER_BINARY entry. A path set here by hand is left alone as long as it exists; one
# that points at nothing is replaced, so a stale override cannot stop the service from starting.
# LLAMA_SERVER_BINARY=service/utils/llama-bin/llama-server

# HF_TOKEN: token used to access private / gated Hugging Face models
# HF_TOKEN=your_huggingface_token_here

# HF_XET_ENABLED: let model downloads use Xet, Hugging Face's chunk-deduplicating
# transfer. Off by default, which trades some download speed for being able to stop a
# download: Xet transfers inside a Rust extension that cannot be interrupted, so with
# it on a cancel only takes effect between files -- stopping a 3B model mid-shard was
# still running 150s later, against 2s with it off. The cost was 4% on the machine
# this was measured on (562s vs 586s for the same 1.18 GB file, on a 2 MB/s link);
# expect more on a fast connection, and on repeat downloads that share chunks with
# what is already cached.
# HF_XET_ENABLED=1

# LLAMA_SERVER_URL: base URL of an externally started llama-server API
# LLAMA_SERVER_URL=http://127.0.0.1:5001

# ==================== Inference tuning (optional) ====================
# Defaults live in service/settings.py; uncomment only what you actually need to change.

# MAX_CONCURRENT_GENERATIONS: how many generations may run at once
# MAX_CONCURRENT_GENERATIONS=8
# MAX_OUTPUT_TOKENS_CAP: blanket ceiling on generated tokens, clamped onto every
# request. Leave unset (the default) and the served context window is the only
# bound, which is what an absent max_tokens means to an OpenAI client. Set a
# number only to impose an operator-wide limit -- it is never used as a default
# for callers that name no cap of their own.
# MAX_OUTPUT_TOKENS_CAP=
# DEFAULT_GENERATION_TIMEOUT: per-generation timeout in seconds, and the default
# for total_timeout on every request that does not name one. This becomes the HTTP
# timeout on the upstream call, so on a streaming request it also bounds the wait
# for the first token -- which is the prefill. A 256K-token prefill was measured at
# ~320s, so anything near the old 300 cuts long-context requests off before they
# answer. Lower it only if you would rather fail fast than serve long prompts.
# DEFAULT_GENERATION_TIMEOUT=1800
# LLAMA_SERVER_API_KEY: the key between this service and llama-server. Unset, one is made up at
# start and given to the llama-server this service starts, so no other client -- including a web
# page open on this machine -- can use it. Set it when pointing at a llama-server of your own.
# LLAMA_SERVER_API_KEY=
# VLLM_PORT: port the managed vLLM server listens on
# VLLM_PORT=5000
# VLLM_HEALTH_TIMEOUT: how long to wait for `vllm serve` to answer /v1/models
# before the load is called a failure. Covers weight loading *and* torch.compile,
# which is why it is minutes rather than seconds -- a BF16 model was still
# compiling when a 300s budget expired, and the server was killed with the
# compile nearly done. A wedged server is still caught; the timeout message says
# how long the subprocess has been silent, which separates the two cases.
# VLLM_HEALTH_TIMEOUT=1800
# VLLM_WARMUP_TIMEOUT: seconds the tiny completion sent right after the health check may
# take. FlashInfer compiles its sampling kernels on the first request, so without this a
# client with a short timeout gives up on a request that was only waiting for the build.
# 0 turns the warm-up off.
# VLLM_WARMUP_TIMEOUT=1800
# VLLM_JIT_GIB_PER_JOB: GiB of RAM budgeted per parallel FlashInfer/nvcc build job, which
# caps MAX_JOBS when you have not set it. One job measured up to 10.3 GiB; with no cap,
# ninja starts nproc+2 of them and a 62 GB machine ran out of memory. Set MAX_JOBS yourself
# and this is ignored; 0 leaves the build uncapped.
# VLLM_JIT_GIB_PER_JOB=11
# VLLM_SERVER_DEV_MODE: mount vLLM's admin endpoints, as --enable-sleep-mode in the extra args also
# does. vLLM then loads a guard that lets programs on this machine use /sleep, /wake_up, /is_sleeping
# and the cache resets, refuses browsers, and answers 404 for /collective_rpc, /update_weights and the
# rest. Off by default; prefix cache cleanup reports as degraded while it is off.
# VLLM_SERVER_DEV_MODE=false
# VLLM_LOGGING_LEVEL: log level for the vLLM subprocess. Left unset, the service
# runs it at INFO during startup only -- so the KV cache size and chosen kernels
# reach the log -- and drops INFO once serving begins, where vLLM emits one line
# per request. Set this and it is honoured verbatim, with no filtering.
# VLLM_LOGGING_LEVEL=ERROR

# ==================== Strata engine (optional) ====================
# engine="strata" starts Strata's own server (github.com/Niko1221/Strata) from an install
# its setup prepared; nothing of it ships with this backend. TRUSTA_SETUP_STRATA=1 with
# setup_env.sh / setup_env.ps1 (or scripts/{linux,windows}/install_strata.*) installs the
# deep-sleep build from a strata-sleep package and records the three paths below. With
# STRATA_HOME empty, the engine is offered only when vendor/ holds that package: the first
# load installs it, and every model's first load runs Strata's setup for it.
# STRATA_HOME: the Strata install (the directory holding serve/server.py)
# STRATA_HOME=
# STRATA_PYTHON: the interpreter for serve/server.py, normally Strata's own .venv python
# STRATA_PYTHON=
# STRATA_ENGINE_BINARY: the engine of the installed strata-sleep package; required. It replaces
# the executable the model's run config names, which Strata's setup installed. Whether it has
# deep sleep is read from the BUILD.json beside it: the CUDA builds do, an Intel Arc one does
# not (deep sleep is CUDA driver virtual memory, and Level Zero has no equivalent).
# STRATA_ENGINE_BINARY=
# STRATA_VISION_BINARY: Strata's image encoder (strata-vision), used when a load asks for image
# input (strata_vision) and the model's run config has none. Empty: the reader beside
# STRATA_ENGINE_BINARY, which the package now carries (an Intel folder's strata-vision-sycl
# before its CPU strata-vision). Any Strata build's encoder reads any model.
# STRATA_VISION_BINARY=
# STRATA_PORT: loopback port of the managed Strata server
# STRATA_PORT=5002
# STRATA_HEALTH_TIMEOUT: seconds to wait for the server to report the model loaded
# STRATA_HEALTH_TIMEOUT=900
# STRATA_RUNTIME_DIR: run config, server log and saved conversation (slot) files
# STRATA_RUNTIME_DIR=./.cache/strata
# STRATA_DATA_DIR: where Strata keeps what it derives from a model -- the expert pack and the
# draft layer, gigabytes of it and minutes to make again. Strata's setup defaults this to
# Strata-data beside the install, which ties it to a folder an uninstall may clear; point it
# somewhere that outlives the install. Empty: Strata's own default.
# The folder is recorded with setup's --set-default-data-dir, so nothing already downloaded
# is moved into it.
# STRATA_DATA_DIR=
# STRATA_INSTALL_DIR: where a first Strata load installs Strata from the package in vendor/
# when STRATA_HOME is empty (empty = strata/ beside this project)
# STRATA_INSTALL_DIR=

# ==================== Redis ====================
# REDIS_HOST: Redis host address
# REDIS_HOST=127.0.0.1
# REDIS_PORT: Redis port
# REDIS_PORT=6379
# REDIS_DB: Redis database number
# REDIS_DB=0
