# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ==================== Service ====================
# SERVICE_HOST: network address FastAPI / Uvicorn binds to
# 127.0.0.1 allows local connections only (recommended); 0.0.0.0 allows external ones (pair it with a reverse proxy and auth)
SERVICE_HOST=127.0.0.1
# SERVICE_PORT: backend API service port
SERVICE_PORT=8000
# UVICORN_RELOAD: enable hot reload; true for development, false recommended in production
UVICORN_RELOAD=false

# ==================== Logging ====================
# LOG_LEVEL: root log level (DEBUG / INFO / WARNING / ERROR / CRITICAL)
LOG_LEVEL=INFO
# LOG_TO_FILE: whether to write logs to a file
LOG_TO_FILE=true
# LOG_DIR: log output directory
LOG_DIR=./logs
# LOG_FILE_NAME: main log file name
LOG_FILE_NAME=service.log
# LOG_BACKUP_COUNT: how many rotated log files to keep
LOG_BACKUP_COUNT=14
# UVICORN_ACCESS_LOG: whether to emit HTTP access logs
UVICORN_ACCESS_LOG=true

# ==================== Paths ====================
# HF_HOME: root directory for Hugging Face models, tokenizers, and download caches
HF_HOME=./.cache/huggingface

# LLAMA_SERVER_BINARY: full path to the llama executable
# (defaults to what setup_env installs: service/utils/llama-bin/llama-server[.exe])
# setup_env fills this line in with the binary it verified, and keeps the file to a single
# LLAMA_SERVER_BINARY entry. A path set here by hand is left alone as long as it exists; one
# that points at nothing is replaced, so a stale override cannot stop the service from starting.
# LLAMA_SERVER_BINARY=service/utils/llama-bin/llama-server

# HF_TOKEN: token used to access private / gated Hugging Face models
# HF_TOKEN=your_huggingface_token_here

# HF_XET_ENABLED: let model downloads use Xet, Hugging Face's chunk-deduplicating
# transfer. Off by default, which trades some download speed for being able to stop a
# download: Xet transfers inside a Rust extension that cannot be interrupted, so with
# it on a cancel only takes effect between files -- stopping a 3B model mid-shard was
# still running 150s later, against 2s with it off. The cost was 4% on the machine
# this was measured on (562s vs 586s for the same 1.18 GB file, on a 2 MB/s link);
# expect more on a fast connection, and on repeat downloads that share chunks with
# what is already cached.
# HF_XET_ENABLED=1

# LLAMA_SERVER_URL: base URL of an externally started llama-server API
# LLAMA_SERVER_URL=http://127.0.0.1:5001

# ==================== Inference tuning (optional) ====================
# Defaults live in service/settings.py; uncomment only what you actually need to change.

# MAX_CONCURRENT_GENERATIONS: how many generations may run at once
# MAX_CONCURRENT_GENERATIONS=8
# MAX_OUTPUT_TOKENS_CAP: blanket ceiling on generated tokens, clamped onto every
# request. Leave unset (the default) and the served context window is the only
# bound, which is what an absent max_tokens means to an OpenAI client. Set a
# number only to impose an operator-wide limit -- it is never used as a default
# for callers that name no cap of their own.
# MAX_OUTPUT_TOKENS_CAP=
# DEFAULT_GENERATION_TIMEOUT: per-generation timeout in seconds, and the default
# for total_timeout on every request that does not name one. This becomes the HTTP
# timeout on the upstream call, so on a streaming request it also bounds the wait
# for the first token -- which is the prefill. A 256K-token prefill was measured at
# ~320s, so anything near the old 300 cuts long-context requests off before they
# answer. Lower it only if you would rather fail fast than serve long prompts.
# DEFAULT_GENERATION_TIMEOUT=1800
# LLAMA_SERVER_API_KEY: API key required by the llama-server endpoint, if it has one
# LLAMA_SERVER_API_KEY=
# VLLM_PORT: port the managed vLLM server listens on
# VLLM_PORT=5000
# VLLM_HEALTH_TIMEOUT: how long to wait for `vllm serve` to answer /v1/models
# before the load is called a failure. Covers weight loading *and* torch.compile,
# which is why it is minutes rather than seconds -- a BF16 model was still
# compiling when a 300s budget expired, and the server was killed with the
# compile nearly done. A wedged server is still caught; the timeout message says
# how long the subprocess has been silent, which separates the two cases.
# VLLM_HEALTH_TIMEOUT=1800
# VLLM_LOGGING_LEVEL: log level for the vLLM subprocess. Left unset, the service
# runs it at INFO during startup only -- so the KV cache size and chosen kernels
# reach the log -- and drops INFO once serving begins, where vLLM emits one line
# per request. Set this and it is honoured verbatim, with no filtering.
# VLLM_LOGGING_LEVEL=ERROR

# ==================== Redis ====================
# REDIS_HOST: Redis host address
# REDIS_HOST=127.0.0.1
# REDIS_PORT: Redis port
# REDIS_PORT=6379
# REDIS_DB: Redis database number
# REDIS_DB=0
