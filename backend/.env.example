# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ==================== Service ====================
# SERVICE_HOST: network address FastAPI / Uvicorn binds to
# 127.0.0.1 allows local connections only (recommended); 0.0.0.0 allows external ones (pair it with a reverse proxy and auth)
SERVICE_HOST=127.0.0.1
# SERVICE_PORT: backend API service port
SERVICE_PORT=8000
# UVICORN_RELOAD: enable hot reload; true for development, false recommended in production
UVICORN_RELOAD=false

# ==================== Logging ====================
# LOG_TO_FILE: whether to write logs to a file
LOG_TO_FILE=true
# LOG_DIR: log output directory
LOG_DIR=./logs
# LOG_FILE_NAME: main log file name
LOG_FILE_NAME=service.log
# LOG_BACKUP_COUNT: how many rotated log files to keep
LOG_BACKUP_COUNT=14
# UVICORN_ACCESS_LOG: whether to emit HTTP access logs
UVICORN_ACCESS_LOG=true
# UVICORN_USE_COLORS: whether terminal logs use color output
UVICORN_USE_COLORS=true
# WATCHFILES_LOG_LEVEL: level of the watchfiles logger itself; WARNING keeps "1 change detected" out of the logs
WATCHFILES_LOG_LEVEL=WARNING

# ==================== Paths ====================
# HF_HOME: root directory for Hugging Face models, tokenizers, and download caches
HF_HOME=./.cache/huggingface

# TIKTOKEN_RS_CACHE_DIR: cache directory for TikToken / GPT-OSS; the backend-local default (service/caches/tiktoken) is fine
TIKTOKEN_RS_CACHE_DIR=service/caches/tiktoken

# LLAMA_SERVER_BINARY: full path to the llama executable
# (defaults to the prebuilt llama installed by install.sh/install.ps1)
# Linux default is usually ~/.local/bin/llama
# Windows default is usually %LOCALAPPDATA%\Microsoft\WindowsApps\llama.exe
# LLAMA_SERVER_BINARY=~/.local/bin/llama

# HF_TOKEN: token used to access private / gated Hugging Face models
# HF_TOKEN=your_huggingface_token_here

# LLAMA_SERVER_URL: base URL of an externally started llama-server API
# LLAMA_SERVER_URL=http://127.0.0.1:5001

# VLLM_SERVER_PROJECT_DIR: project directory of the isolated vLLM environment
# VLLM_SERVER_PROJECT_DIR=./service/inference/engines/vllm_server

# REDIS_HOST: Redis host address
# REDIS_HOST=127.0.0.1
# REDIS_PORT: Redis port
# REDIS_PORT=6379
# REDIS_DB: Redis database number
# REDIS_DB=0
