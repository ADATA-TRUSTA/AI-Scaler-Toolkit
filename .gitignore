*/__pycache__/*

# Environment variables (sensitive data)
.env

# Python
*.pyc
__pycache__/
*.so
*.egg-info/
build/
*venv*/

# Model files and caches
*offload/
*.bin
*.safetensors
models/
checkpoints/
.cache/
finetune_output/
backend/service/utils/llama.cpp/

# Backend runtime state (regenerated at runtime; must not be committed even if upstream ships them)
backend/service/configs/current_*.json
backend/service/configs/last_finetuned_model.json
backend/service/model_offload/
# models_registry.json holds machine-specific local paths. It must stay untracked:
# ModelRegistry._ensure_file() only seeds SEED_BASE_MODELS when the file is absent,
# so shipping one leaves a fresh clone with an empty model list.
backend/service/configs/models_registry.json
# RAG store: SQLite DB + document copies, both created on first use.
backend/service/rag_store/rag.db
backend/service/rag_store/docs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# LLM wiki local metadata
wiki/.llm-wiki/
wiki/.obsidian/

# Logs
*.log
logs/

# GitHub metrics archive (published to gh-pages by CI, not tracked on code branches)
data/metrics/
